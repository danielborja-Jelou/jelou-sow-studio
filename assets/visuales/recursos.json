{
  "version": 2,
  "leeme": "Catálogo de recursos visuales del simulador. Cada recurso = señales (cuándo aplica) + receta (qué se dibuja). Se empareja contra el texto de cada paso del SOW y de su integración. Se amplía sin tocar código: en la carpeta del usuario (~/.claude/jelou-sow-studio/visuales/recursos.json), con `node scripts/aprender_recurso.js`, o por cliente en sow.json > demo.recursos. Ver references/simulador-visual.md.",
  "variables": "En cualquier texto de una receta: {{marca}} {{cliente}} {{proveedor}} {{monto}} {{concepto}} {{documento}} {{usuario_nombre}} {{usuario_telefono}} {{numero}} {{etapa}} {{mensaje}} {{caption}}. Una imagen se pide con { \"generar\": \"ticket-qr|documento-identidad|selfie|factura|producto|firma|pantalla\" } o con un archivo { \"src\": \"captura.png\" } (se busca en la carpeta del recurso, en la del usuario y junto al sow.json).",
  "recursos": [
    {
      "id": "foto-usuario",
      "nombre": "Foto o archivo que envía la persona",
      "aplica_a": [
        "usuario"
      ],
      "senales": {
        "mensaje": "^\\s*\\[\\s*(foto|imagen|captura|selfie|escaneo|archivo)[^\\]]*\\]",
        "componente": "an[aá]lisis de imagen"
      },
      "generadores": [
        {
          "texto": "qr|ticket|c[oó]digo de barras",
          "generar": "ticket-qr",
          "alt": "Ticket con código QR",
          "nota": "Imagen de ejemplo: el QR no es legible."
        },
        {
          "texto": "c[eé]dula|dni|pasaporte|documento de identidad|identidad",
          "generar": "documento-identidad",
          "alt": "Documento de identidad"
        },
        {
          "texto": "selfie|rostro|cara",
          "generar": "selfie",
          "alt": "Selfie"
        },
        {
          "texto": "factura|comprobante|recibo",
          "generar": "factura",
          "alt": "Factura"
        },
        {
          "texto": "producto|art[ií]culo|da[nñ]o|evidencia",
          "generar": "producto",
          "alt": "Foto"
        }
      ],
      "generador_por_defecto": {
        "generar": "pantalla",
        "alt": "Foto"
      },
      "receta": {
        "abre": "pasos",
        "pasos": [
          {
            "tipo": "usuario",
            "texto": "{{caption}}",
            "imagen": {
              "generar": "{{generar}}",
              "alt": "{{alt}}"
            }
          }
        ]
      }
    },
